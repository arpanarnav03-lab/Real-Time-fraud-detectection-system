# Optional — if unset, the system falls back to rule-based explanations
# instead of calling the LLM (graceful degradation, no crash).
ANTHROPIC_API_KEY=your_key_here

# Required — Postgres connection string, pointed at a Neon project. Copy the
# pooled connection string from the Neon dashboard (Connect > Connection
# string); it already includes sslmode=require and channel_binding=require.
DATABASE_URL=postgresql://<user>:<password>@<endpoint-id>.<region>.aws.neon.tech/<dbname>?sslmode=require&channel_binding=require

# Required — signs and verifies JWT auth tokens. Never hardcode this; generate
# a random value with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your_random_secret_here
